# Copy this file to .env and paste your OpenAI key:
#   cp .env.example .env
#
# Get a key at https://platform.openai.com/api-keys
# Used by POST /api/rationale-labels (and the unused /api/chat).

# Optional public site origin(s), comma-separated:
# FRONTEND_ORIGINS=https://your-app.example

# Set to 1 when the site is served over HTTPS.
# COOKIE_SECURE=1

# Max study accounts (same email always maps to the same canvas).
# STUDY_CAP=15

# Door 1: invitation code shown before login. Put this in the invite email.
# Without it, anyone with the URL can reach the login screen.
STUDY_ACCESS_CODE=repertoire2026

# Optional invite list: backend/data/allowlist.txt (one email per line).
# If that file has emails, only those addresses can enter — even with the access code.

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
